# ─────────────────────────────────────────────────────────────────────────────
# StockBook environment variables. Copy to `.env` and fill in real values.
# Every variable is validated at startup (src/shared/config/env.ts); the app
# refuses to start if a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development

# Public URL of the web app (scheme + host [+ port], no trailing slash).
# Used for the CSRF Origin check and for absolute links.
APP_URL=http://localhost:3000

# Extra origins allowed to make cookie-authenticated mutations (comma-separated).
# Usually empty. Example: https://stockbook.example.com,https://www.stockbook.example.com
TRUSTED_ORIGINS=

# Set to true when running behind a reverse proxy (Coolify/Traefik) so the
# client IP is taken from X-Forwarded-For and the host from X-Forwarded-Host.
TRUST_PROXY=false

# All timestamps are stored in UTC and displayed in this zone.
TZ=Asia/Dhaka

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://stockbook:stockbook@localhost:5432/stockbook?schema=public

# ── Redis ───────────────────────────────────────────────────────────────────
# Used for login rate limiting, the permission cache and the BullMQ queue.
REDIS_URL=redis://localhost:6379
# Prefix for every cache/rate-limit key (lets several environments share one Redis).
REDIS_KEY_PREFIX=sb:

# ── Tokens ──────────────────────────────────────────────────────────────────
# HS256 secret for signing access-token JWTs. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# HMAC key used to hash refresh tokens before they are stored. At least 32 chars.
# Rotating it invalidates every refresh token (everyone has to log in again).
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string-32-chars
# JWT "iss" claim.
JWT_ISSUER=stockbook
# Access-token lifetime in seconds (default 900 = 15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh-token lifetime in days (each refresh issues a new token with a fresh lifetime).
REFRESH_TOKEN_TTL_DAYS=30

# ── Cookies (web client) ────────────────────────────────────────────────────
# Secure flag on auth cookies. MUST be true in production (HTTPS). Set false
# only for plain-http local development.
COOKIE_SECURE=false
# Optional cookie domain (leave empty to scope cookies to the exact host).
COOKIE_DOMAIN=

# ── Login protection ────────────────────────────────────────────────────────
# Failed attempts per username inside the window before the account is locked.
LOGIN_MAX_FAILURES=5
# Window for counting failed attempts, in seconds (default 900 = 15 minutes).
LOGIN_FAILURE_WINDOW_SECONDS=900
# bcrypt cost factor for password hashes.
BCRYPT_ROUNDS=12

# ── Seed: initial Admin user ────────────────────────────────────────────────
# Created by the seed script if no user with this username exists yet.
# The password is only used on first creation; change it later from the UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator

# ── Object storage (S3-compatible) ──────────────────────────────────────────
# Product photos (and later invoices / challans). The bucket must be PRIVATE:
# files are served only through authenticated API routes.
# Dev: MinIO from docker-compose (console http://localhost:9001, minioadmin/minioadmin).
# Prod: any S3-compatible service, e.g. Contabo Object Storage
#   S3_ENDPOINT=https://eu2.contabostorage.com  S3_REGION=default  S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=stockbook
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true for MinIO / Contabo (bucket in the path); false for virtual-hosted style (AWS).
S3_FORCE_PATH_STYLE=true
# Create the bucket on first use (dev / tests). Use false in production and create it yourself.
S3_AUTO_CREATE_BUCKET=true

# ── Logging ─────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Container release (docker/entrypoint.sh) ────────────────────────────────
# When true, the app container runs `prisma migrate deploy` + the idempotent
# seed before starting. Enable it on the app service only, not the worker.
RUN_MIGRATIONS=true
# The seed adds sample suppliers, customers and projects to empty tables.
# Set to false in production to start with empty masters.
SEED_SAMPLE_DATA=true

# ── Stock documents (worker) ────────────────────────────────────────────────
# Name printed on GRNs, challans and invoices.
COMPANY_NAME=StockBook
# Headless Chromium for PDF rendering. The Docker image sets it; locally the
# worker finds Chrome / Edge automatically when this is empty.
PDF_BROWSER_PATH=

# ── Reports ─────────────────────────────────────────────────────────────────
# A report query is cancelled after this many milliseconds (503 QUERY_TIMEOUT).
REPORT_QUERY_TIMEOUT_MS=30000

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Emails go out only through the worker's `email` queue (retries with backoff).
# Leave SMTP_HOST empty to disable email: in-app notifications still work and
# every email is logged as SKIPPED. docker compose uses Mailpit (http://localhost:8025).
SMTP_HOST=
# 587 = STARTTLS (SMTP_SECURE=false), 465 = implicit TLS (SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StockBook <no-reply@your-domain.com>
# First retry after this many ms (then doubles), up to EMAIL_MAX_ATTEMPTS tries.
EMAIL_RETRY_DELAY_MS=30000
EMAIL_MAX_ATTEMPTS=5
