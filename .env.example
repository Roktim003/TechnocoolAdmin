# ═════════════════════════════════════════════════════════════════════════════
# StockBook environment variables
#
# Copy to `.env` (development) or `.env.prod` (docker-compose.prod.yml) and fill in.
# Every variable is validated at startup (src/shared/config/env.ts): the app REFUSES TO START
# when a required one is missing, a secret is shorter than 32 bytes, or (in production) a
# secret still has an example value. Check a file with:  npm run ops -- check-env
#
# Legend:  [required] must be set   [optional] has a default or can stay empty
#          [secret]   never commit, never log, store in your platform's secret store
#
# Nothing here is tied to a hosting provider. The "FILL IN LATER" section at the end lists
# what can stay empty until the server, domain, mail account and backup storage are chosen.
# ═════════════════════════════════════════════════════════════════════════════

# development | production | test                                           [optional]
NODE_ENV=development
# Display / storage timezone. Keep Asia/Dhaka.                                [optional]
TZ=Asia/Dhaka

# ── App URL ────────────────────────────────────────────────────────────────
# Public URL of the web app: scheme + host [+ port], no trailing slash.      [required]
# Used for the CSRF origin check, links in emails and HSTS (sent only when this is https).
# Until the domain is chosen use the server address, e.g. http://203.0.113.10:3000
APP_URL=http://localhost:3000
# Extra origins allowed to POST with the login cookie (comma-separated). Usually empty. [optional]
TRUSTED_ORIGINS=
# Browser origins allowed to call the API cross-origin (CORS), comma-separated. [optional]
# Empty = CORS closed (recommended). Mobile apps don't need CORS. Cookies are never sent cross-origin.
CORS_ORIGINS=
# true behind a reverse proxy / load balancer: client IP from X-Forwarded-For.   [optional]
TRUST_PROXY=false

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL 16 connection string (Prisma).                         [required] [secret]
DATABASE_URL=postgresql://stockbook:stockbook@localhost:5432/stockbook?schema=public
# Connections per process (web and worker each have a pool). Empty = Prisma default
# (CPU count × 2 + 1). See docs/deployment-notes.md for sizes.                [optional]
DATABASE_POOL_SIZE=

# ── Redis ──────────────────────────────────────────────────────────────────
# Redis 7: queues, rate limits, sessions, caches. Include the password.   [required] [secret]
# Production: AOF on and maxmemory-policy noeviction (docker-compose.prod.yml does this).
REDIS_URL=redis://localhost:6379
# Prefix for every key (lets several environments share one Redis).            [optional]
REDIS_KEY_PREFIX=sb:

# ── Tokens and sessions ────────────────────────────────────────────────────
# HS256 key for access tokens. At least 32 random bytes; different from the next one.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# [required] [secret]
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# HMAC key for stored refresh tokens. At least 32 random bytes. Rotating it logs everyone out.
# [required] [secret]
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string-32-chars
# JWT "iss" claim.                                                             [optional]
JWT_ISSUER=stockbook
# Access-token lifetime in seconds (default 900 = 15 min).                     [optional]
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh-token lifetime in days.                                              [optional]
REFRESH_TOKEN_TTL_DAYS=30
# Web sessions end after this many minutes without activity (0 = never). Mobile is exempt. [optional]
SESSION_IDLE_TIMEOUT_MINUTES=30
# Secure flag on login cookies. MUST be true once the app is on https.         [optional]
COOKIE_SECURE=false
# Cookie domain; empty = the exact host (recommended).                          [optional]
COOKIE_DOMAIN=

# ── Login protection and passwords ─────────────────────────────────────────
# Failed logins per username in the window before the account is locked.     [optional]
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
# bcrypt cost. At least 12 in production (enforced).                           [optional]
BCRYPT_ROUNDS=12

# ── Rate limits and request size ───────────────────────────────────────────
# Per user, per minute. 429 with Retry-After when exceeded.                    [optional]
RATE_LIMIT_API_PER_MINUTE=300
# Excel / PDF jobs per user per minute (exports, documents, cost statements).  [optional]
RATE_LIMIT_EXPORTS_PER_MINUTE=10
# Token refreshes per client IP per minute.                                    [optional]
RATE_LIMIT_REFRESH_PER_MINUTE=30
# Largest JSON body (KB) and largest upload (MB) the API accepts (413 above).  [optional]
MAX_JSON_BODY_KB=1024
MAX_UPLOAD_MB=25

# ── Seed: first Admin user ─────────────────────────────────────────────────
# Created by `migrate` (seed) if no user with this username exists. The password is used
# only on first creation; change it in the app afterwards.                    [required]
ADMIN_USERNAME=admin
# At least 10 characters.                                            [required] [secret]
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator
# Sample suppliers, customers and projects for demos. false in production.     [optional]
SEED_SAMPLE_DATA=true

# ── File storage (S3-compatible) ───────────────────────────────────────────
# Product photos, attachments, exports. The bucket must be PRIVATE (files are served only
# through authenticated API routes). Any S3-compatible service works; dev uses MinIO.
# [required]
S3_ENDPOINT=http://localhost:9000
# [optional]
S3_REGION=us-east-1
# [required]
S3_BUCKET=stockbook
# [required] [secret]
S3_ACCESS_KEY_ID=minioadmin
# [required] [secret]
S3_SECRET_ACCESS_KEY=minioadmin
# true = bucket in the path (MinIO and most S3-compatible services); false = AWS style. [optional]
S3_FORCE_PATH_STYLE=true
# Create the bucket on first use (dev / tests only). false in production.     [optional]
S3_AUTO_CREATE_BUCKET=true

# ── Logging ────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent (JSON lines on stdout). [optional]
LOG_LEVEL=info

# ── Documents and reports ──────────────────────────────────────────────────
# Name printed on GRNs, challans, invoices and reports.                       [optional]
COMPANY_NAME=StockBook
# Headless Chromium for PDFs. The Docker image sets it; locally Chrome / Edge is found. [optional]
PDF_BROWSER_PATH=
# A report query is cancelled after this many milliseconds (503 QUERY_TIMEOUT). [optional]
REPORT_QUERY_TIMEOUT_MS=30000

# ── Worker resources (see docs/deployment-notes.md for 8 GB / 12 GB values) ─
# Queues this worker consumes: "*" = all, "!name" excludes ("*,!backups").     [optional]
WORKER_QUEUES=*
# PDFs rendered at the same time per worker, and PDFs before Chromium restarts. [optional]
PDF_CONCURRENCY=1
PDF_BROWSER_RESTART_AFTER=50
# V8 heap cap in MB for this process (Docker entrypoint → NODE_OPTIONS). Empty = Node default. [optional]
NODE_MEMORY_MB=
# Graceful shutdown: how long in-flight requests / jobs may take after SIGTERM. [optional]
SHUTDOWN_TIMEOUT_MS=25000
# Admins are alerted when more jobs than this fail within an hour.             [optional]
FAILED_JOBS_ALERT_THRESHOLD=10
# Email retries: first delay (ms, doubles) and attempts.                      [optional]
EMAIL_RETRY_DELAY_MS=30000
EMAIL_MAX_ATTEMPTS=5

# ── Backups (local part) ───────────────────────────────────────────────────
# Where encrypted dumps are written. /backups is the Docker volume.            [optional]
BACKUP_DIR=./backups
# Retention, applied to the local folder and the off-site bucket.              [optional]
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Run a backup before every `migrate` (true recommended).                       [optional]
BACKUP_BEFORE_MIGRATE=true

# ── Release info (set by the image build; shown on System health) ──────────
APP_VERSION=0.7.0
GIT_COMMIT=local

# ═════════════════════════════════════════════════════════════════════════════
# FILL IN LATER — optional services that are not decided yet
#
# Leave these empty for now. The app keeps working and System health lists each one as
# "not set up yet". Fill them in when the mail account / backup storage / error tracking
# are ready, then restart web, worker and backup.
# ═════════════════════════════════════════════════════════════════════════════

# ── Email (SMTP) ───────────────────────────────────────────────────────────
# Empty SMTP_HOST: emails are still queued and logged with status NOT_SENT_SMTP_MISSING,
# in-app notifications work, and System health shows "Email is not set up yet".
# Local development: `docker compose up mailpit` and SMTP_HOST=localhost, SMTP_PORT=1025
# (inbox at http://localhost:8025).
# [optional]
SMTP_HOST=
# 587 = STARTTLS (SMTP_SECURE=false), 465 = implicit TLS (SMTP_SECURE=true).     [optional]
SMTP_PORT=587
SMTP_SECURE=false
# [optional]
SMTP_USER=
# [optional] [secret]
SMTP_PASS=
# Sender shown on every email.                                                  [optional]
SMTP_FROM=StockBook <no-reply@your-domain.example>

# ── Off-site backup storage (S3-compatible bucket, any provider) ───────────
# Empty: backups are kept only in BACKUP_DIR on this server, and System health shows
# "Off-site backup not set up yet: backups are only on this server". All four are needed.
# [optional]
BACKUP_S3_ENDPOINT=
# [optional]
BACKUP_S3_REGION=us-east-1
# [optional]
BACKUP_S3_BUCKET=
# [optional] [secret]
BACKUP_S3_KEY=
# [optional] [secret]
BACKUP_S3_SECRET=
# Folder inside the bucket (db/ and attachments/ go under it).                 [optional]
BACKUP_S3_PREFIX=stockbook
BACKUP_S3_FORCE_PATH_STYLE=true
# Passphrase for backup encryption (AES-256), at least 32 bytes. Without it backups are NOT
# encrypted and are never copied off-site. KEEP A COPY OUTSIDE THE SERVER: without it the
# backups can't be restored.                                         [optional] [secret]
BACKUP_ENCRYPTION_KEY=

# ── Error tracking (Sentry or a Sentry-compatible service) ─────────────────
# Empty: errors go to the structured logs only.                                [optional]
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
