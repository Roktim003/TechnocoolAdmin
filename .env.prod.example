# Values for docker-compose.prod.yml. Copy to .env.prod (never commit it) and fill in.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod --profile local up -d --build
# Every variable is explained in .env.example. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ── required ──
# The address users open. Until the domain exists: http://<server-ip>:3000
APP_URL=http://localhost:3000
# false while APP_URL is plain http (local test); true as soon as it is https.
COOKIE_SECURE=false
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
REFRESH_TOKEN_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# File storage. With --profile local these are also the MinIO root credentials.
S3_ACCESS_KEY_ID=stockbook
S3_SECRET_ACCESS_KEY=
S3_BUCKET=stockbook
# S3_ENDPOINT=https://<your-provider-endpoint>   (default: the local MinIO)

# ── sizes (defaults suit an 8 GB server; see docs/deployment-notes.md) ──
# WEB_DB_POOL=10
# WORKER_DB_POOL=5
# WEB_NODE_MEMORY_MB=768
# WORKER_NODE_MEMORY_MB=768
# PDF_CONCURRENCY=1

# ── fill in later (leave empty for now) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
SENTRY_DSN=
